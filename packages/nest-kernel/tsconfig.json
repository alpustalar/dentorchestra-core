{
  "include": ["src"],
  "exclude": ["node_modules", "dist"],
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2021",
    "baseUrl": "./",
    "noEmit": true,
    // Paket içindeki dosyalar birbirine `@common/*` / `@src/*` ile bakar (tüketen
    // app'lerdeki adlandırmayla aynı). Burada bu alias'lar paketin KENDİ src'sine
    // bağlanır — böylece paket, bir app'in tsconfig'i olmadan da tek başına
    // tip-kontrolünden geçirilebilir (`pnpm --filter @dentorchestra/nest-kernel typecheck`).
    "paths": {
      "@common/*": ["src/common/*"],
      "@src/*": ["src/*"],
      "@shared": ["../shared/index"],
      "@shared/*": ["../shared/*"],
      "@input-type-schemas/*": ["../shared/generated-zod/inputTypeSchemas/*"],
      "@model-schema/*": ["../shared/generated-zod/modelSchema/*"]
    },
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false
  }
}
