# Bu dosyayı `.env.local` olarak kopyalayıp doldur. `.env.local` git'e girmez.

# Sürümleme öneki DAHİL taban adres. Sunucu bileşenlerinden de çağrıldığı için
# mutlak olmalı — Node'un fetch'i göreli yolu çözemez.
# Üretimde web ve api aynı ters vekilin arkasındaysa: https://alan-adin
NEXT_PUBLIC_API_URL=http://localhost:8080

# Geliştirme sırasında Orval'in ürettiği MSW handler'larını açmak için:
# NEXT_PUBLIC_API_MOCKING=enabled

# Firebase Web yapılandırması (Console → Proje ayarları → Web uygulaması).
# Bu değerler gizli değildir; Firebase Web anahtarları tasarım gereği açıktır ve
# güvenlik backend'in Admin SDK doğrulamasından gelir.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
