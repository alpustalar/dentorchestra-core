{
  "name": "@core-crm/api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "stats": "cloc . --exclude-dir=node_modules,dist,.git",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "cross-env NODE_ENV=development nest start --watch --entryFile apps/api/src/main.js",
    "start:debug": "cross-env nest start --debug --watch",
    "start:prod": "cross-env NODE_ENV=production node apps/api/src/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prisma:generate": "prisma generate && pnpm zod:clean",
    "migrate:dev": "prisma migrate dev && pnpm zod:clean",
    "zod:clean": "node scripts/clean-generated-zod.cjs",
    "gen:module": "node scripts/generate-module.mjs",
    "gen:cqrs": "node scripts/generate-cqrs.cjs",
    "migrate:messaging-mongo": "cross-env NODE_ENV=${NODE_ENV:-development} ts-node -r tsconfig-paths/register src/infrastructure/persistence/mongo/scripts/migrate-messaging-to-mongo.ts"
  },
  "prisma": {
    "seed": "ts-node -r tsconfig-paths/register src/infrastructure/persistence/prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@bull-board/api": "^7.1.5",
    "@bull-board/express": "^7.1.5",
    "@bull-board/nestjs": "^7.1.5",
    "@core-crm/nest-kernel": "workspace:*",
    "@core-crm/shared": "workspace:*",
    "@duffel/api": "^4.28.0",
    "@logtail/node": "^0.5.6",
    "@logtail/winston": "^0.5.6",
    "@nestjs-modules/ioredis": "^2.0.2",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/mapped-types": "*",
    "@nestjs/microservices": "^11.1.28",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.2.5",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^6.19.2",
    "axios": "^1.16.1",
    "bullmq": "^5.71.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "dayjs": "^1.11.20",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.3",
    "express-basic-auth": "^1.2.1",
    "firebase-admin": "^13.6.0",
    "google-libphonenumber": "^3.2.44",
    "helmet": "^8.1.0",
    "ioredis": "^5.9.2",
    "iyzipay": "^2.0.67",
    "joi": "^18.0.2",
    "mongoose": "^9.1.5",
    "nanoid": "^5.1.6",
    "nats": "^2.29.3",
    "nest-winston": "^1.10.2",
    "nestjs-zod": "^5.1.1",
    "nodemailer": "^7.0.13",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "slugify": "^1.6.6",
    "stripe": "^22.3.0",
    "swagger-ui-express": "^5.0.1",
    "telegraf": "^4.16.3",
    "telegram": "^2.26.22",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/google-libphonenumber": "^7.4.30",
    "@types/iyzipay": "^2.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^7.0.9",
    "@types/supertest": "^6.0.2",
    "cloc": "2.6.0-cloc",
    "cross-env": "^10.1.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "inquirer": "^8.2.7",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "^6.19.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "zod-prisma-types": "^3.3.11"
  },
  "jest": {
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "rootDir": "src",
    "roots": [
      "<rootDir>",
      "<rootDir>/../../../packages/nest-kernel/src"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@common/(.*)$": [
        "<rootDir>/common/$1",
        "<rootDir>/../../../packages/nest-kernel/src/common/$1"
      ],
      "^@modules/(.*)$": "<rootDir>/modules/$1",
      "^@src/(.*)$": [
        "<rootDir>/$1",
        "<rootDir>/../../../packages/nest-kernel/src/$1"
      ],
      "^@shared/modules/(.*)$": "<rootDir>/../../../packages/shared/modules/$1",
      "^@shared/common/(.*)$": "<rootDir>/../../../packages/shared/common/$1",
      "^@shared$": "<rootDir>/../../../packages/shared/index",
      "^@shared/(.*)$": "<rootDir>/../../../packages/shared/$1",
      "^@input-type-schemas/(.*)$": "<rootDir>/../../../packages/shared/generated-zod/inputTypeSchemas/$1"
    }
  }
}
