MODE=<DEVELOPMENT|PRODUCTION>

PORT=8080

ADMIN_EMAIL=admin@example.com

# PRISMA (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL=postgresql://johndoe:randompassword@localhost:5432/mydb?schema=public

# MONGO (Loglar veya dinamik veriler için)
MONGODB_URI=mongodb://localhost:27017/nest_logs
# Messaging kendi Mongo veritabanını kullanır. Çok-dokümanlı transaction gerektirdiği
# için sunucu replica set modunda olmalı (tek düğüm yeterli) ve URI'de belirtilmeli.
MESSAGING_MONGODB_URI=mongodb://localhost:27017/core-crm-messaging?replicaSet=rs0

# BETTERSTACK LOG SERVICE (Production için kritik)
BETTERSTACK_TOKEN=your_source_token_here

# REDIS (Caching ve Queue yönetimi)
REDIS_URL=redis://

## Servisler arası mesajlaşma (apps/api ↔ apps/messaging)
NATS_URL=nats://localhost:4222

# CLIENT_ORIGINS (CORS ayarları için virgülle ayrılmış liste)
ALLOWED_ORIGINS=http://localhost:3000,https://myapp.com

#TOKEN CRYPT
TOKEN_CIPHER_KEY=<32_byte_hex>

#MAIL
EMAIL_SMTP_HOST=
EMAIL_ADDRESS=
EMAIL_PASSWORD=
EMAIL_TLS_PORT=

#IYZICO
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=

#POS (fiziksel POS — sağlayıcı callback imzası)
# Fiziksel POS sağlayıcısının işlem sonucunu bildirdiği uç (POST /api/v1/pos/callback/:externalRef)
# kimlik doğrulaması olmadan çağrılır ve bir PENDING işlemi SUCCESS'e çevirebilir — yani para
# alınmadan tahsilat/gelir yazdırabilir. Bu yüzden gövde HMAC-SHA256 ile doğrulanır:
#   x-pos-signature: sha256=<ham gövdenin bu anahtarla HMAC-SHA256'sı, hex>
# Kapı FAIL-CLOSED: anahtar tanımsızsa uç 503 döner (imza doğrulanamadığı için istek kabul
# edilmez). Sağlayıcı tarafına da aynı değer girilir. Üretim: openssl rand -hex 32
POS_CALLBACK_SECRET=<32_byte_hex>

# OPERASYONEL UYARI KANALI (Slack incoming webhook)
# Sistemin "bir şeyi yapamadım, birinin bakması lazım" dediği tek kanal: muhasebe
# köprüsünün yutulan hatası, ölü mektuba düşen outbox kaydı, kiracı sınırı ihlali,
# eksi kasayla kapanış, denetim izinin yazılamaması — 40'tan fazla çağrı yeri buraya basar.
# TANIMSIZSA uyarılar kaybolmaz ama **yalnız log'a** yazılır (`LogOpsAlertAdapter`):
# CRITICAL → logger.error, WARNING → logger.warn. Log'u kimse izlemiyorsa, alarma
# bağlanmış onlarca güvence fiilen sessizdir — bu yüzden üretimde açılışta uyarı basılır.
# İkinci değişken yalnız CRITICAL'i ayrı bir kanala ayırmak için; tanımsızsa hepsi
# birinci kanala gider. Aynı olayın tekrarları 10 dk boyunca birleştirilir (dedupeKey).
# Slack: Incoming Webhooks → Add New Webhook to Workspace
SLACK_OPS_WEBHOOK_URL=
SLACK_OPS_WEBHOOK_URL_CRITICAL=

#QUEUE MONITOR
QUEUE_MONITOR_ADMIN_PASSWORD=

#META
# https://developers.facebook.com/
META_APP_ID=
META_APP_SECRET=

META_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/meta-ads/oauth/callback

# Meta Developer Console → Webhooks → Verify Token alanına girilecek
META_WEBHOOK_VERIFY_TOKEN=<32_byte_hex>

#WHATSAPP (messaging — WhatsApp Cloud API)
# Meta App → WhatsApp. APP_ID Embedded Signup için, APP_SECRET webhook imzası (x-hub-signature-256) için.
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
# Meta Developer Console → WhatsApp → Webhooks → Verify Token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=<32_byte_hex>

#AI (messaging — AI sohbet asistanı)
# Platform fallback anahtarı; klinikler kendi anahtarlarını bağlamazsa bu kullanılır.
ANTHROPIC_API_KEY=
# Opsiyonel global varsayılan model (boşsa claude-haiku-4-5)
ANTHROPIC_DEFAULT_MODEL=claude-haiku-4-5

GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=
## TELEGRAM (MTProto api_id/api_hash app-seviyesi; Bot token klinik başına DB'de şifreli)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
PUBLIC_BASE_URL=
## INSTAGRAM (Meta Graph / Messenger Platform — app-seviyesi; Page/IG token klinik başına DB'de şifreli)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
## HOTEL BEDS
HOTELBEDS_HOTEL_API_KEY=
HOTELBEDS_HOTEL_SECRET=
HOTELBEDS_TRANSFER_API_KEY=
HOTELBEDS_TRANSFER_SECRET=

# DUFFEL (uçuş) — opsiyonel: tanımsızsa yalnız uçuş uçları devre dışı kalır.
# Test/canlı ayrımı token'ın kendisindedir: duffel_test_... / duffel_live_...
DUFFEL_ACCESS_TOKEN=
## STRIPE (yurtdışı müşteri için EUR/USD ödeme linki — sağlık turizmi B7)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
## FX — net (EUR/USD) → TRY çevrimi (iyzico TRY ister); v1 statik env oranı
FX_EUR_TRY=
FX_USD_TRY=
FX_GBP_TRY=
## Sağlık turizmi (otel + transfer) satış komisyonu % — PLATFORM geliri (klinik değil).

HEALTH_TOURISM_SERVICE_FEE_PERCENT=