enum PlanId {
  FREE_TRIAL
  BASIC
  PREMIUM
}

enum SubStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

/// Aboneliğin faturalandırma hedefi — org merkezî mi öder yoksa her klinik ayrı mı (franchise).
/// Org ayarından (OrganizationFinanceSettings.subscriptionBillingTarget) türetilip denormalize edilir.
enum BillingTarget {
  ORGANIZATION
  CLINIC
}

model Module {
  id           String   @id
  key          String   @unique // "E_INVOICE", "POS_INTEGRATION"
  name         String
  description  String?
  monthlyPrice Decimal  @map("monthly_price") @db.Decimal(10, 2)
  currency     Currency
  isActive     Boolean  @default(true) @map("is_active")

  items       SubscriptionItem[]
  planModules PlanModule[]

  @@map("modules")
}

/// Plan tanımı — sabit PlanId'ye bağlı, admin-düzenlenebilir fiyat + modül bundle.
/// PlanId enum sabittir (yeni plan eklenmez); Plan satırı fiyat/isim/modülleri taşır.
model Plan {
  id     String @id
  planId PlanId @unique

  name         String
  monthlyPrice Decimal  @map("monthly_price") @db.Decimal(10, 2)
  currency     Currency
  isActive     Boolean  @default(true) @map("is_active")

  modules PlanModule[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("plans")
}

/// Plan ↔ Module bundle (many-to-many) — bir plana dahil modüller.
model PlanModule {
  id        String @id
  planRowId String @map("plan_id") // FK → Plan.id (enum planId ile karışmasın diye planRowId)
  moduleId  String @map("module_id")

  plan   Plan   @relation(fields: [planRowId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([planRowId, moduleId])
  @@map("plan_modules")
}

model Subscription {
  id String @id

  organizationId String  @map("organization_id")
  // partial unique index ile (WHERE clinic_id IS NULL) sağlanır.
  clinicId       String? @unique @map("clinic_id")

  /// Sağlayıcı **korelasyon anahtarı** (iyzico `conversationId`): ödeme callback'i
  /// aboneliği YALNIZ bunun üzerinden bulur (`findByExternalIdForUpdate`). Bu yüzden
  /// ödeme kimliğiyle EZİLMEZ — eskiden `confirmPayment`/`renew` buraya
  /// `iyzicoPaymentId` yazıyordu ve ilk bildirimden sonra anahtar kaybolduğu için
  /// sağlayıcının ikinci bildirimi (iyzico callback + webhook ikilisi) aboneliği
  /// bulamayıp 404 alıyordu; o bildirimde gelen `savedCard` da kayboluyordu.
  externalId     String? @unique @map("external_id")

  /// Son BAŞARILI tahsilatın sağlayıcı kimliği — bilgi amaçlı ve idempotency
  /// kontrolü için (aynı ödeme kimliği tekrar bildirilirse işlem no-op'tur).
  /// Tahsilat GEÇMİŞİ burada değil `subscription_charges` tablosundadır.
  providerPaymentId String? @map("provider_payment_id")

  billingTarget BillingTarget @default(ORGANIZATION) @map("billing_target")

  // Sahip org her zaman dolu (her klinik bir org'a bağlı). clinicId yalnız CLINIC hedefte dolu.
  // Tekillik: clinicId nullable @unique (klinik-başına tek); org-başına tek (org hedef) migration'da

  status SubStatus @default(ACTIVE)

  trialEndsAt DateTime? @map("trial_ends_at")

  currentPeriodStart DateTime? @map("current_period_start")
  currentPeriodEnd   DateTime? @map("current_period_end")
  cancelAtPeriodEnd  Boolean   @default(false) @map("cancel_at_period_end")

  organization Organization @relation(fields: [organizationId], references: [id])
  clinic       Clinic?      @relation(fields: [clinicId], references: [id])

  items         SubscriptionItem[]
  charges       SubscriptionCharge[]
  paymentMethod SubscriptionPaymentMethod?
  createdAt     DateTime                   @default(now()) @map("created_at")
  updatedAt     DateTime                   @updatedAt @map("updated_at")

  // Optimistic concurrency control — her save() ile artar; guard'lı update eşzamanlı
  // lost-update'i (ör. yenileme job'u vs. kullanıcı iptali yarışı) yakalar.
  version Int @default(0)

  @@index([organizationId])
  @@map("subscriptions")
}

/// Kayıtlı ödeme yöntemi (kart saklama) — otomatik yenileme (recurring auto-charge) için.
/// İlk ödemede müşteri kartını saklarsa iyzico cardUserKey+cardToken üretir; yenileme günü
/// bu token'larla non-3DS payment.create çağrılır. buyer* alanları yenileme anında
/// iyzico'nun zorunlu tuttuğu alıcı bilgisini yeniden kurmak için snapshot'lanır.
model SubscriptionPaymentMethod {
  id             String @id
  subscriptionId String @unique @map("subscription_id")

  provider String @default("IYZICO")

  cardUserKey String @map("card_user_key")
  cardToken   String @map("card_token")

  // Görüntüleme metadata'sı (kart maskesi/kuruluşu)
  maskedNumber    String? @map("masked_number")
  cardAssociation String? @map("card_association")
  cardFamily      String? @map("card_family")

  // Yenileme anında payment.create için alıcı (buyer) snapshot'ı
  buyerName      String  @map("buyer_name")
  buyerSurname   String  @map("buyer_surname")
  buyerEmail     String  @map("buyer_email")
  buyerGsmNumber String  @map("buyer_gsm_number")
  buyerIp        String  @map("buyer_ip")
  buyerCity      String? @map("buyer_city")
  buyerAddress   String? @map("buyer_address")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("subscription_payment_methods")
}

model SubscriptionItem {
  id              String  @id
  subscriptionId  String  @map("subscription_id")
  planId          PlanId?
  moduleId        String? @map("module_id")
  externalPriceId String? @map("external_price_id")

  priceAtPurchase Decimal  @map("price_at_purchase") @db.Decimal(10, 2)
  currency        Currency

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  module       Module?      @relation(fields: [moduleId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([subscriptionId, planId])
  @@unique([subscriptionId, moduleId])
  @@map("subscription_items")
}

/// Platformun kendi tahsilatının durumu. `PENDING` **para çekilmeden önce**
/// yazılır (claim); bu yüzden "PENDING kalmış" satır "çekim yapıldı mı bilinmiyor"
/// demektir ve otomatik yeniden denenMEZ — insan mutabakatı ister.
enum SubscriptionChargeStatus {
  PENDING
  SUCCEEDED
  FAILED
}

/// Platformun abonelikten tahsil ettiği paranın DEFTERİ.
///
/// Neden ayrı tablo: önceden tahsilatın tek izi (a) audit log satırı ve (b) her
/// yenilemede ÜZERİNE YAZILAN `subscriptions.external_id` idi. Sonuçları:
/// iade edilemiyordu (ödeme kimliği kaybolduğu için), sağlayıcıyla mutabakat
/// yapılamıyordu, "bu ay ne tahsil ettik" sorusu cevaplanamıyordu ve en önemlisi
/// **dönem başına idempotency anahtarı yoktu**: başarılı çekimden sonra
/// transaction geri alınırsa (statement timeout, pod kill, outbox yazım hatası)
/// bir sonraki zamanlanmış çalıştırma kartı İKİNCİ KEZ çekiyordu.
///
/// `@@unique([subscriptionId, periodStart])` bunun DB tarafındaki kilidi: bir
/// dönem için en fazla bir tahsilat satırı. Satır çekimden ÖNCE commit edilir
/// (claim-then-charge), böylece para hareketi her zaman kaydının arkasından gelir.
model SubscriptionCharge {
  id String @id

  subscriptionId String @map("subscription_id")
  organizationId String @map("organization_id")

  /// Tahsilatın karşılığı olan fatura dönemi. `periodStart` idempotency anahtarının
  /// parçasıdır: aynı dönem iki kez tahsil edilemez.
  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")

  /// Çekilmek ÜZERE olan tutar (bizim beyanımız).
  amount   Decimal  @db.Decimal(10, 2)
  currency Currency

  /// Sağlayıcının fiilen tahsil ettiğini bildirdiği tutar. iyzico'da taksitli
  /// ödemede `paidPrice > price` olabilir; fark mutabakatta görünmek zorundadır.
  paidAmount Decimal? @map("paid_amount") @db.Decimal(10, 2)

  status SubscriptionChargeStatus @default(PENDING)

  /// Sağlayıcı ödeme kimliği — iadenin ÖN KOŞULU.
  providerPaymentId String? @map("provider_payment_id")
  /// Korelasyon anahtarı (ilk ödemede checkout `conversationId`'si).
  conversationId String? @map("conversation_id")

  failureReason String? @map("failure_reason")
  /// Kaçıncı deneme — başarısız dönem yeniden denenebilir (dunning), ama aynı
  /// satır üzerinde: yeni satır açmak dönem başına tekillik kısıtını kırardı.
  attempts Int @default(1)

  chargedAt DateTime? @map("charged_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@unique([subscriptionId, periodStart])
  @@index([organizationId])
  @@index([status])
  @@map("subscription_charges")
}
