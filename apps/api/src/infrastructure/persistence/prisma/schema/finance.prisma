enum LedgerStatus {
  COMPLETED
  CANCELLED
  REFUNDED
  /// Kart itirazı kaybedildi (ters ibraz) — para iade edilmedi, sağlayıcı geri aldı.
  CHARGED_BACK
}

enum LedgerType {
  INCOME
  EXPENSE
}

enum LedgerSource {
  PAYMENT_MODULE // Bir Payment kaydına bağlı otomatik oluşan gelir
  INVENTORY_MODULE // Stok alımı/satımı sonucu oluşan hareket
  MANUAL_ENTRY // elle girilen kira, maaş,
}

enum LedgerCategory {
  TREATMENT_PAYMENT
  REFUND
  MATERIAL_PURCHASE
  STOCK_ADJUSTMENT
  SALARY
  RENT
  OTHER
}

model FinanceLedger {
  id             String  @id
  organizationId String  @map("organization_id")
  clinicId       String  @map("clinic_id")
  patientId      String? @map("patient_id")
  paymentId      String? @map("payment_id")
  installmentId  String? @unique @map("installment_id")
  performedById  String? @map("performed_by_id")

  type     LedgerType
  source   LedgerSource
  category LedgerCategory
  status   LedgerStatus   @default(COMPLETED)

  amount   Decimal  @db.Decimal(10, 2)
  currency Currency @default(TRY)

  taxRate   Int     @default(0) @map("tax_rate")
  taxAmount Decimal @default(0) @map("tax_amount") @db.Decimal(10, 2)

  description String?
  documentNo  String? @map("document_no")

  entryDate DateTime @default(now()) @map("entry_date")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  payment       Payment?            @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  installment   PaymentInstallment? @relation(fields: [installmentId], references: [id], onDelete: SetNull)
  patient       Patient?            @relation(fields: [patientId], references: [id], onDelete: SetNull)
  performedBy   User?               @relation(fields: [performedById], references: [id], onDelete: SetNull)
  stockMovement StockMovement?

  @@index([organizationId, entryDate])
  @@index([clinicId, entryDate])
  @@index([patientId])
  @@map("finance_ledger")
}

enum PaymentStatus {
  PENDING
  PARTIAL
  COMPLETED
  CANCELLED
  REFUNDED
  FAILED
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  BANK_TRANSFER
  EFT
  MAIL_ORDER
  CHEQUE
  BOND
}

enum InstallmentStatus {
  PENDING
  COMPLETED
  OVERDUE
  CANCELLED
  REFUNDED
  /// Kart itirazı (chargeback) KAYBEDİLDİ: para iade edilmedi, sağlayıcı kart
  /// sahibinin lehine geri aldı. `REFUNDED` değildir — iade bizim kararımızla
  /// geri verilen paradır, bu ise geri alınan paradır; hasta borcu hâlâ geçerlidir
  /// ve aynı tutarda bir telafi taksiti (`recoversInstallmentId`) açılır.
  CHARGED_BACK
}

model Payment {
  id            String  @id
  clinicId      String  @map("clinic_id")
  patientId     String  @map("patient_id")
  appointmentId String? @unique @map("appointment_id")
  providerId    String? @map("provider_id")

  totalAmount Decimal  @map("total_amount") @db.Decimal(10, 2)
  currency    Currency @default(TRY)

  status PaymentStatus @default(PENDING)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  patient     Patient      @relation(fields: [patientId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  provider    Provider?    @relation(fields: [providerId], references: [id])

  installments   PaymentInstallment[]
  financeLedgers FinanceLedger[]
  patientPackage PatientTreatmentPackage?
  /// Çoklu: iptal edilmiş fatura yerinde kalır; tahsilat için en fazla **bir
  /// etkin** fatura olur (kısmî unique index), geçmişte iptal edilenler durur.
  invoices       Invoice[]

  @@map("payments")
}

model PaymentInstallment {
  id        String @id
  paymentId String @map("payment_id")

  installmentNo Int               @map("installment_no")
  amount        Decimal           @db.Decimal(10, 2)
  currency      Currency          @default(TRY)
  method        PaymentMethod     @default(CREDIT_CARD)
  dueDate       DateTime?         @map("due_date")
  paidAt        DateTime?         @map("paid_at")
  note          String?
  status        InstallmentStatus @default(PENDING)

  /// Bu taksit, ters ibrazla (chargeback) geri alınan hangi taksidin YERİNE açıldı.
  /// Telafi taksiti hastadan yeniden tahsil edilecek aynı tutardır; `@unique` bir
  /// taksidin yalnız bir telafisi olabileceğini DB'de sabitler (aynı itirazın
  /// yeniden işlenmesi ikinci bir alacak doğurmasın).
  recoversInstallmentId String? @unique @map("recovers_installment_id")

  /// Parayı kart sahibine geri götüren bir girişim (iade/iptal) sağlayıcıya GİTTİ ve
  /// sonucu kesinleşmedi (kural 18). SDK çağrısı transaction dışında yapıldığı için
  /// uçuştaki iade, aynı taksitte açılan bir itirazı kendi başına göremez; bu damga,
  /// çağrıdan ÖNCE ve ödeme satırı kilitliyken yazılır. Doluyken itiraz açılamaz.
  /// Sağlayıcı açıkça reddederse temizlenir; zaman aşımında (sonuç bilinmiyor) kalır.
  reversalRequestedAt DateTime? @map("reversal_requested_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  payment             Payment             @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  iyzicoTransaction   IyzicoTransaction?
  financeLedger       FinanceLedger?
  recoversInstallment PaymentInstallment? @relation("InstallmentRecovery", fields: [recoversInstallmentId], references: [id], onDelete: SetNull)
  recoveredBy         PaymentInstallment? @relation("InstallmentRecovery")

  @@unique([paymentId, installmentNo])
  @@index([paymentId])
  @@map("payment_installments")
}

enum IyzicoTransactionStatus {
  INITIALIZE
  SUCCESS
  FAILURE
  REFUNDED
}

model IyzicoTransaction {
  id                         String  @id
  installmentId              String  @unique @map("installment_id")
  conversationId             String  @unique @map("conversation_id")
  iyzicoPaymentId            String? @map("iyzico_payment_id")
  iyzicoPaymentTransactionId String? @map("iyzico_payment_transaction_id")

  token String? @map("token")

  rawResponse Json? @map("raw_response")

  status       IyzicoTransactionStatus
  errorCode    String?                 @map("error_code")
  errorMessage String?                 @map("error_message")

  installment PaymentInstallment @relation(fields: [installmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("iyzico_transactions")
}
enum EDocumentProvider {
  NILVERA
  LOGO
  PARASUT
}

enum EDocumentEnvironment {
  TEST
  PRODUCTION
}

enum EDocumentIntegrationScope {
  CLINIC
  ORGANIZATION
}

/// E-belge sağlayıcı kimlikleri. Secret'lar uygulama katmanında AES-256-GCM ile
/// tek bir şifreli blob'a çevrilir; bu tablo düz API key/şifre taşımaz.
model EDocumentIntegrationConfig {
  id String @id

  scope       EDocumentIntegrationScope
  provider    EDocumentProvider
  environment EDocumentEnvironment

  credentialsCiphertext String  @map("credentials_ciphertext") @db.Text
  credentialHint       String? @map("credential_hint")
  isActive              Boolean @default(true) @map("is_active")
  lastTestedAt          DateTime? @map("last_tested_at")
  lastTestSucceeded     Boolean? @map("last_test_succeeded")

  clinicId       String? @unique @map("clinic_id")
  organizationId String? @unique @map("organization_id")

  clinic       Clinic?       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([provider, isActive])
  @@map("e_document_integration_configs")
}
