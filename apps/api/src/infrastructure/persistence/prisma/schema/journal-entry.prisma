// Yevmiye fişi (JournalEntry) + satırları (JournalLine).
// Bir FinancialEvent'ten posting motoru tarafından üretilir. event_id unique →
// olay başına en fazla bir fiş (idempotentlik). POSTED fiş değişmez; düzeltme storno ile.

enum JournalEntryStatus {
  DRAFT
  POSTED
  REVERSED
}

/// Fişin **niteliği**: ekonomik bir olayı mı kaydediyor, yoksa dönem sonu tekniği mi?
/// Gelir tablosu bu ayrımı okumak zorunda: kapanış fişi 6/7 hesaplarını sıfırlayan
/// teknik bir kayıttır, kapanmış yılın gelir tablosu onu sayarsa **sıfır ciro**
/// gösterir (her satır kendi içinde dengeli olduğu için hata sessizdir). Bilanço ise
/// tersine kapanışı saymak ZORUNDADIR — kârı öz kaynağa (590) taşıyan fiş odur.
enum JournalEntryKind {
  OPERATIONAL /// ekonomik olay (posting kuralı) ve onun stornosu
  CLOSING /// yıl sonu kapanış fişi (yansıtma, 6/7 → 690, 690 → 590/591) — gelir tablosuna girmez
  /// Dönem sonu DÜZELTME: GRNI tahakkuku (mal geldi, fatura gelmedi) ve ertesi yılın 1 Ocak'ındaki ters kaydı.
  /// Teknik değil EKONOMİKTİR: tahakkukun gider satırı (ör. 770) ait olduğu yılın gelir tablosunda görünmek,
  /// ters kaydı da yeni yılda faturayla birlikte sıfırlanmak zorundadır — bu yüzden gelir tablosu SAYAR
  /// (CLOSING'in tersi). `329` hesabına yalnız bu türdeki fişler yazar (`finans:degismezler` zorlar).
  ADJUSTING
}

model JournalEntry {
  id             String  @id
  clinicId       String  @map("clinic_id") // defter sahibi şube (source-of-truth)
  organizationId String  @map("organization_id") // denormalize — konsolide raporlama
  periodId       String  @map("period_id")
  eventId        String? @unique @map("event_id") // idempotentlik
  reversedById   String? @map("reversed_by_id")
  performedById  String? @map("performed_by_id")

  entryNo     BigInt?            @map("entry_no") // POSTED olunca atanır, boşluksuz sıralı
  entryDate   DateTime           @map("entry_date")
  description String?
  status      JournalEntryStatus @default(DRAFT)

  // Storno, ters kaydettiği fişin niteliğini DEVRALIR (entity'de zorlanır): bir
  // kapanış fişinin stornosu OPERATIONAL olsaydı gelir tablosuna ters işaretle
  // girer ve kapanmış yılın cirosunu şişirirdi.
  kind JournalEntryKind @default(OPERATIONAL)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  clinic     Clinic           @relation(fields: [clinicId], references: [id])
  period     AccountingPeriod @relation(fields: [periodId], references: [id])
  event      FinancialEvent?  @relation(fields: [eventId], references: [id])
  reversedBy JournalEntry?    @relation("JournalReversal", fields: [reversedById], references: [id])
  reversals  JournalEntry[]   @relation("JournalReversal")
  lines      JournalLine[]

  // Yevmiye numarası dönem içinde tekil. Tahsis zaten AccountingPeriod.lastEntryNo
  // sayacıyla serileştirilir; bu kısıt emniyet kemeridir (NULL'lar çakışmaz →
  // numarasız DRAFT fişler kısıtı tetiklemez).
  @@unique([clinicId, periodId, entryNo])
  @@index([clinicId, entryDate])
  @@index([organizationId, entryDate])
  @@index([periodId])
  @@map("journal_entries")
}

model JournalLine {
  id        String  @id
  entryId   String  @map("entry_id")
  accountId String  @map("account_id")
  partyId   String? @map("party_id") // 120/320 satırlarında zorunlu (alt defter)

  // debit/credit DAİMA defterin fonksiyonel para birimindedir (Model A). currency
  // de fonksiyonel para birimini taşır — yabancı işlemler posting anında çevrilir.
  debit    Decimal  @default(0) @db.Decimal(14, 2)
  credit   Decimal  @default(0) @db.Decimal(14, 2)
  currency Currency @default(TRY)

  // Yabancı para izlenebilirliği (yalnız çevrilmiş satırlarda dolu; aksi halde null).
  // original* = işlemin ORİJİNAL para birimindeki tutarı; fxRate = orijinal→fonksiyonel kuru.
  originalDebit    Decimal?  @map("original_debit") @db.Decimal(14, 2)
  originalCredit   Decimal?  @map("original_credit") @db.Decimal(14, 2)
  originalCurrency Currency? @map("original_currency")
  fxRate           Decimal?  @map("fx_rate") @db.Decimal(18, 6)

  lineDesc String? @map("line_desc")

  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account Account      @relation(fields: [accountId], references: [id])
  party   Party?       @relation(fields: [partyId], references: [id])

  @@index([entryId])
  @@index([accountId])
  @@index([partyId])
  @@map("journal_lines")
}
