enum PosTransactionStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  TIMEOUT
}

enum PosProvider {
  PAX
  IYZICO_TERMINAL
}

/// Bir POS kaydının satış mı yoksa onu tersleyen bir iptal/iade mi olduğunu ayırır.
/// VOID satışın tamamını geri alır (en fazla bir canlı kayıt), REFUND kısmi olabilir
/// (birden çok canlı kayıt; toplamı satışı aşamaz — kural handler'da kilit altında).
enum PosTransactionKind {
  SALE
  VOID
  REFUND
}

model PosDevice {
  id             String  @id
  clinicId       String  @map("clinic_id")
  terminalId     String? @map("terminal_id")
  merchantId     String? @map("merchant_id")
  deviceUniqueId String? @map("device_unique_id")

  label    String
  provider PosProvider @default(PAX)
  // PAX (POSLINK / TCP) — provider = PAX için doldurulur
  host     String?
  port     Int?

  // iyzico Terminal (Host API) — provider = IYZICO_TERMINAL için doldurulur

  isActive  Boolean  @default(true) @map("is_active")
  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  clinic       Clinic           @relation(fields: [clinicId], references: [id])
  transactions PosTransaction[]

  @@index([clinicId])
  @@map("pos_devices")
}

// Kliniğin iyzico Terminal (Host API) merchant kimlikleri — finance bounded-context
// 1:1 satellite. Sırlar klinik başına tek yerde yaşar; cihazlar deviceUniqueId ile bağlanır.
model ClinicIyzicoTerminalConfig {
  id String @id

  clientId String @map("client_id")
  clinicId String @unique @map("clinic_id")

  clientSecret String @map("client_secret")
  username     String
  password     String

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("clinic_iyzico_terminal_configs")
}

model PosTransaction {
  id            String  @id
  posDeviceId   String  @map("pos_device_id")
  clinicId      String  @map("clinic_id")
  patientId     String? @map("patient_id")
  appointmentId String? @map("appointment_id")
  paymentId     String? @map("payment_id")

  amount   Decimal  @db.Decimal(12, 2)
  currency Currency @default(TRY)

  status      PosTransactionStatus @default(PENDING)
  externalRef String?              @map("external_ref")

  kind PosTransactionKind @default(SALE)

  /// Ters kaydın (VOID/REFUND) geri aldığı orijinal satış. Satışlarda null.
  /// Denetim izidir — kaydın durumu ne olursa olsun korunur.
  originalPosTransactionId String? @map("original_pos_transaction_id")

  /// İptal (VOID) kilidi: yalnız CANLI bir iptal kaydında (PENDING/SUCCESS) dolu olur,
  /// iptal FAILED/CANCELLED/TIMEOUT'a düştüğünde null'a çekilir. Postgres'te NULL'lar
  /// birbiriyle çakışmadığı için `@unique` burada "bir satışın en fazla BİR canlı iptali
  /// olabilir; başarısız denemeden sonra tekrar denenebilir" kuralını partial unique index
  /// semantiğiyle uygular — ama raw SQL yerine Prisma'nın gördüğü bir kısıt olarak
  /// (aksi halde ileride üretilecek bir migration index'i sessizce düşürebilirdi).
  /// İadeler kısmi olabildiği için bu kilidi kullanmaz; kümülatif tutar kontrolü
  /// handler'da, orijinal satır FOR UPDATE kilitliyken yapılır.
  activeVoidOriginalId String? @unique @map("active_void_original_id")

  /// İşlemi terminalde başlatan personel (Firebase UID — ham string, UUID değil).
  /// SALE'de kartı çeken, VOID/REFUND'da ters kaydı atan kişidir: her ters kayıt
  /// kendi satırı olduğu için tek kolon ikisini de damgalar (CLAUDE.md kural 7 —
  /// yüksek etkili işlem kalıcı damga ister). Eski satırlar için null; yeni kayıtta
  /// `CreatePosTransactionProps.initiatedById` ZORUNLU, çünkü varsayılanı olamaz:
  /// "sistem" damgası, kartı fiilen çeken kişinin yerine geçtiği an izi yok eder.
  initiatedById String? @map("initiated_by_id")

  rawRequest  Json?     @map("raw_request")
  rawResponse Json?     @map("raw_response")
  initiatedAt DateTime  @default(now()) @map("initiated_at")
  completedAt DateTime? @map("completed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  posDevice   PosDevice    @relation(fields: [posDeviceId], references: [id])
  patient     Patient?     @relation(fields: [patientId], references: [id], onDelete: SetNull)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  original  PosTransaction?  @relation("PosTransactionReversal", fields: [originalPosTransactionId], references: [id])
  reversals PosTransaction[] @relation("PosTransactionReversal")

  @@index([clinicId])
  @@index([posDeviceId])
  @@index([originalPosTransactionId])
  @@map("pos_transactions")
}
