model TreatmentCategory {
  id       String @id
  sectorId String @map("sector_id")
  slug     String @unique

  sector           Sector            @relation(fields: [sectorId], references: [id])
  masterTreatments MasterTreatment[]
  treatments       Treatment[]

  translations TreatmentCategoryTranslation[]

  @@map("treatment_categories")
}

model TreatmentCategoryTranslation {
  id                  String @id
  languageId          String @map("language_id")
  treatmentCategoryId String @map("treatment_category_id")

  name        String
  description String?

  language          Language          @relation(fields: [languageId], references: [id])
  treatmentCategory TreatmentCategory @relation(fields: [treatmentCategoryId], references: [id])
}

model MasterTreatment {
  id                  String @id
  treatmentCategoryId String @map("treatment_category_id")

  slug String @unique

  defaultDuration Int     @map("default_duration")
  // Resmi SUT prosedür kodu — AppointmentProcedure oluşturulurken default olarak kullanılır
  sutCode         String? @map("sut_code")

  treatments   Treatment[]
  translations TreatmentTranslation[]

  treatmentCategory TreatmentCategory @relation(fields: [treatmentCategoryId], references: [id])

  @@map("master_treatments")
}

model TreatmentTranslation {
  id String @id

  masterTreatmentId String? @map("master_treatment_id")
  languageId        String  @map("language_id")
  treatmentId       String? @map("treatment_id")

  name                  String
  description           String?
  aftercareInstructions String? @map("aftercare_instructions")

  language        Language         @relation(fields: [languageId], references: [id])
  masterTreatment MasterTreatment? @relation(fields: [masterTreatmentId], references: [id])
  treatment       Treatment?       @relation(fields: [treatmentId], references: [id])

  @@unique([masterTreatmentId, languageId])
  @@unique([treatmentId, languageId])
  @@map("master_treatment_translations")
}

model Treatment {
  id String @id

  slug                String
  treatmentCategoryId String @map("treatment_category_id")

  duration    Int?
  minDuration Int? @map("min_duration")
  maxDuration Int? @map("max_duration")

  // MasterTreatment.sutCode'u override etmek için — null ise master'ınki kullanılır
  sutCode String? @map("sut_code")

  description      String? @db.Text
  isActive         Boolean @default(true) @map("is_active")
  requiresApproval Boolean @default(false) @map("requires_approval")
  isPackageOnly    Boolean @default(false) @map("is_package_only")
  displayOrder     Int     @default(0) @map("display_order")

  // Liste (etiket) fiyatı — KDV hariç. İndirimin ölçüldüğü referanstır: satır
  // oluşurken TreatmentCharge.listPrice'a kopyalanıp DONDURULUR, sonradan burada
  // yapılan zam geçmiş satırları değiştirmez. null = fiyatlandırılmamış işlem
  // (yalnız pakete dahil veya ücretsiz kontrol).
  listPrice Decimal? @map("list_price") @db.Decimal(10, 2)
  currency  Currency @default(TRY)

  clinicId          String  @map("clinic_id")
  masterTreatmentId String? @map("master_treatment_id")

  translations       TreatmentTranslation[]
  appointments       Appointment[]
  providerTreatments ProviderTreatment[]
  medicalFile        MedicalFile[]

  clinic            Clinic            @relation(fields: [clinicId], references: [id])
  masterTreatment   MasterTreatment?  @relation(fields: [masterTreatmentId], references: [id])
  treatmentCategory TreatmentCategory @relation(fields: [treatmentCategoryId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  packageItems TreatmentPackageItem[]
  charges      TreatmentCharge[]

  @@unique([clinicId, slug])
  @@index([deletedAt])
  @@map("treatments")
}

/// Randevuda yapılan işlemin **fiyatlı satırı**. Ticari gerçeğin tek kaydıdır:
/// ne yapıldı, liste fiyatı neydi, ne kadar indirim verildi, net ne kaldı.
///
/// Fiyat ve indirim satır oluşurken DONDURULUR — tedavinin liste fiyatı sonradan
/// değişse bile geçmiş satır değişmez. İndirim hastanın üstünde kalıcı bir oran
/// olarak değil, işlem anına ait bir kayıt olarak yaşar; böylece raporlanabilir,
/// denetlenebilir ve tavana tabi tutulabilir olur.
///
/// Fatura ve tahsilat tutarları bu satırlardan türer.
model TreatmentCharge {
  id             String @id
  organizationId String @map("organization_id")
  clinicId       String @map("clinic_id")
  appointmentId  String @map("appointment_id")
  patientId      String @map("patient_id")
  treatmentId    String @map("treatment_id")

  description String? // satır açıklaması (boşsa tedavi adı kullanılır)
  quantity    Decimal @default(1) @db.Decimal(10, 3)

  // --- Fiyatlandırma (hepsi KDV hariç, satır oluşurken donar) ---
  listPrice      Decimal  @map("list_price") @db.Decimal(10, 2) // birim liste fiyatı
  discountRate   Decimal  @default(0) @map("discount_rate") @db.Decimal(5, 2) // %
  discountAmount Decimal  @default(0) @map("discount_amount") @db.Decimal(12, 2)
  discountReason String?  @map("discount_reason")
  netAmount      Decimal  @map("net_amount") @db.Decimal(12, 2) // matrah = liste×adet − indirim
  vatRate        Int      @map("vat_rate")
  vatAmount      Decimal  @map("vat_amount") @db.Decimal(12, 2)
  grossAmount    Decimal  @map("gross_amount") @db.Decimal(12, 2) // net + KDV
  currency       Currency @default(TRY)

  // Tavanı aşan indirimi onaylayan yönetici (aşılmadıysa null) — denetim izi.
  discountApprovedById String? @map("discount_approved_by_id")

  createdById String?   @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  // Satır iptali: fatura kesildikten sonra silinemez, iptal edilir (iz kalır).
  voidedAt    DateTime? @map("voided_at")
  voidReason  String?   @map("void_reason")
  // İptali yapan personel (Firebase UID — UUID değil). `voidedAt` tek başına
  // "kim" sorusunu yanıtlamıyordu; satır faturanın ticari dayanağı olduğu için
  // kalıcı damga zorunlu (CLAUDE.md finans kuralı 7).
  voidedById  String?   @map("voided_by_id")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  treatment   Treatment   @relation(fields: [treatmentId], references: [id])

  @@index([clinicId])
  @@index([appointmentId])
  @@index([patientId])
  @@index([treatmentId])
  @@map("treatment_charges")
}

// ─── Treatment Packages ───────────────────────────────────────────────────────

enum PatientPackageStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  SUSPENDED
}

model TreatmentPackage {
  id       String @id
  clinicId String @map("clinic_id")

  name             String
  examinationCount Int      @map("examination_count")
  controlCount     Int      @map("control_count")
  validityDays     Int      @map("validity_days")
  price            Decimal  @db.Decimal(10, 2)
  currency         Currency @default(TRY)

  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  clinic Clinic @relation(fields: [clinicId], references: [id])

  items           TreatmentPackageItem[]
  providers       TreatmentPackageProvider[]
  patientPackages PatientTreatmentPackage[]

  @@index([clinicId])
  @@map("treatment_packages")
}

model TreatmentPackageItem {
  id          String @id
  packageId   String @map("package_id")
  treatmentId String @map("treatment_id")

  count Int

  package   TreatmentPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  treatment Treatment        @relation(fields: [treatmentId], references: [id])

  @@unique([packageId, treatmentId])
  @@map("treatment_package_items")
}

model TreatmentPackageProvider {
  id         String @id
  packageId  String @map("package_id")
  providerId String @map("provider_id")

  package  TreatmentPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  provider Provider         @relation(fields: [providerId], references: [id])

  @@unique([packageId, providerId])
  @@map("treatment_package_providers")
}

model PatientTreatmentPackage {
  id         String  @id
  patientId  String  @map("patient_id")
  packageId  String  @map("package_id")
  providerId String  @map("provider_id")
  paymentId  String? @unique @map("payment_id")

  startDate DateTime             @map("start_date")
  endDate   DateTime             @map("end_date")
  notes     String?              @db.Text
  status    PatientPackageStatus @default(ACTIVE)

  usedExaminationCount Int @default(0) @map("used_examination_count")
  usedControlCount     Int @default(0) @map("used_control_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  patient  Patient          @relation(fields: [patientId], references: [id])
  package  TreatmentPackage @relation(fields: [packageId], references: [id])
  provider Provider         @relation(fields: [providerId], references: [id])
  payment  Payment?         @relation(fields: [paymentId], references: [id])

  @@index([patientId])
  @@index([packageId])
  @@map("patient_treatment_packages")
}
