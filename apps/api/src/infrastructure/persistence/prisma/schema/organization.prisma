model Organization {
  id   String @id
  name String
  slug String @unique

  phone    String?
  email    String? @unique
  address  String? @db.Text
  city     String?
  district String?

  status   GlobalStatus @default(ACTIVE)
  timezone TimeZone     @default(Europe_Istanbul)

  /// Platformun (bizim) kendi kiracı satırı. Sağlık turizmi komisyonu klinik
  /// değil platform geliridir; defter clinicId zorunlu olduğu için platform da
  /// bir kiracı olarak modellenir ve kendi defterini tutar. Kiracıya dönük
  /// listeler/raporlar bu bayrakla dışlar. Sistemde en fazla bir tane olur.
  isPlatform Boolean @default(false) @map("is_platform")

  clinics            Clinic[]
  patients           Patient[]
  organizationOwners User[]    @relation("organization_owners")

  // Finansal modeller clinic seviyesine taşındı (Clinic = source-of-truth).
  // organizationId bu modellerde denormalize scalar FK (navigation yok).

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Polimorfik faturalandırma: org-billed'de tek, clinic-billed (franchise) durumda klinik-başına çok.
  subscriptions  Subscription[]
  financeSettings OrganizationFinanceSettings?
  eDocumentIntegrationConfig EDocumentIntegrationConfig?

  @@map("organizations")
}

/// Organizasyonun finansal davranış ayarları (1:1 satellite) — ClinicFinanceSettings'in org-seviye
/// karşılığı. `subscriptionBillingTarget` platform aboneliğinin org'a mı yoksa her kliniğe mi
/// faturalanacağını belirler (franchise). İleride billing contact/VKN/currency için genişler.
model OrganizationFinanceSettings {
  id String @id

  subscriptionBillingTarget BillingTarget @default(ORGANIZATION) @map("subscription_billing_target")

  organizationId String       @unique @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("organization_finance_settings")
}
