// Muhasebe (ledger) katmanı — Hesap Planı (TDHP) + Dönem
// Defter clinic (şube/mükellef) seviyesinde tutulur — finansal source-of-truth.
// organizationId, konsolide üst yönetim raporlaması için denormalize edilmiş
// scalar FK olarak taşınır (navigation yok; Organization karşı-ilişkisi tutulmaz).

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum AccountSide {
  DEBIT
  CREDIT
}

model Account {
  id             String  @id
  clinicId       String  @map("clinic_id")
  organizationId String  @map("organization_id") // denormalize — konsolide raporlama
  parentId       String? @map("parent_id")

  code String // '120', '600.04', '120.01.0001'
  name String

  type       AccountType
  normalSide AccountSide @map("normal_side")

  isPostable    Boolean @default(true) @map("is_postable") // sadece yaprak hesaba fiş atılır
  requiresParty Boolean @default(false) @map("requires_party") // 120/320 → alt defter (cari) zorunlu

  currency Currency?
  isActive Boolean   @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  clinic Clinic @relation(fields: [clinicId], references: [id])

  parent       Account?      @relation("AccountTree", fields: [parentId], references: [id])
  children     Account[]     @relation("AccountTree")
  journalLines JournalLine[]

  @@unique([clinicId, code])
  @@index([clinicId, parentId])
  @@index([organizationId])
  @@map("accounts")
}

enum AccountingPeriodStatus {
  OPEN
  LOCKED
  CLOSED
}

model AccountingPeriod {
  id             String @id
  clinicId       String @map("clinic_id")
  organizationId String @map("organization_id") // denormalize — konsolide raporlama

  year     Int
  status   AccountingPeriodStatus @default(OPEN)
  startsAt DateTime               @map("starts_at")
  endsAt   DateTime               @map("ends_at")

  // Yevmiye numarası sayacı. Numara DAİMA buradan, fişin yazıldığı transaction
  // içinde `UPDATE ... SET last_entry_no = last_entry_no + 1 ... RETURNING` ile
  // alınır: satır kilidi numarayı serileştirir (mükerrer imkânsız) ve aynı kilit
  // dönem kapanışıyla çakışarak kapalı döneme fiş atılmasını da engeller.
  // MAX(entry_no)+1 YASAK — kilitsiz okuma iki fişe aynı numarayı verir.
  lastEntryNo BigInt @default(0) @map("last_entry_no")

  // Denetim damgaları: mali yılı kim/ne zaman kapattı, kilitli dönemi kim açtı.
  lockedAt     DateTime? @map("locked_at")
  lockedById   String?   @map("locked_by_id")
  reopenedAt   DateTime? @map("reopened_at")
  reopenedById String?   @map("reopened_by_id")
  closedAt     DateTime? @map("closed_at")
  closedById   String?   @map("closed_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  clinic         Clinic         @relation(fields: [clinicId], references: [id])
  journalEntries JournalEntry[]

  @@unique([clinicId, year])
  @@index([organizationId])
  @@map("accounting_periods")
}
