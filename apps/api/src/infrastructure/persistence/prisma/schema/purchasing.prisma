// Satın Alma (Procure-to-Pay): Talep (PR) → Onay → Sipariş (PO) → Mal Kabul.
// `supply/purchasing` modülü. Supplier + Product `supply/inventory`'de kalır
// (bounded-context: navigation yok, yalnızca scalar id). Teslimde ReceiveStockCommand
// ile stok girişi tetiklenir (cross-module). clinicId/organizationId denormalize scalar.

enum PurchaseRequestStatus {
  DRAFT // taslak
  SUBMITTED // onaya gönderildi
  APPROVED // onaylandı
  REJECTED // reddedildi
  CANCELLED // iptal
  ORDERED // siparişe dönüştürüldü
}

enum PurchaseOrderStatus {
  DRAFT // taslak
  SENT // tedarikçiye gönderildi
  PARTIALLY_RECEIVED // kısmen teslim alındı
  RECEIVED // tamamen teslim alındı
  CANCELLED // iptal
}

/// Siparişin fatura eşleştirme (matching) durumu. Teslimattan bağımsız yürür:
/// mal gelmiş ama fatura gelmemiş ya da tersi olabilir.
enum PurchaseOrderBillingStatus {
  NOT_BILLED // hiç fatura eşleşmedi
  PARTIALLY_BILLED // kısmen faturalandı
  FULLY_BILLED // sipariş tutarının tamamı faturalandı
}

/// Mal kabul kaydının kaynağı. `LEGACY_BACKFILL`: günlük kurulmadan önce yapılmış kabuller
/// (yalnız kümülatif sayaç vardı, tarih yoktu) — migration sayaçtan TÜRETTİ; `received_at`
/// siparişin son güncelleme anıdır, **yaklaşık** bir tarihtir ve yıl sonu önizlemesinde
/// ayrıca işaretlenir.
enum PurchaseOrderReceiptSource {
  GOODS_RECEIPT // mal kabul komutu
  LEGACY_BACKFILL // günlükten önceki kabullerin sayaçtan türetilmiş kaydı
}

model PurchaseRequest {
  id             String @id
  clinicId       String @map("clinic_id")
  organizationId String @map("organization_id")
  requestedById  String @map("requested_by_id")

  status   PurchaseRequestStatus @default(SUBMITTED)
  neededBy DateTime?             @map("needed_by")
  note     String?               @db.Text

  reviewedById String?   @map("reviewed_by_id")
  reviewedAt   DateTime? @map("reviewed_at")
  reviewNote   String?   @map("review_note")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items PurchaseRequestItem[]

  @@index([clinicId, status])
  @@index([organizationId])
  @@map("purchase_requests")
}

model PurchaseRequestItem {
  id        String @id
  requestId String @map("request_id")

  productId          String?  @map("product_id") // katalog ürünü (opsiyonel)
  description        String // ürün adı snapshot'ı veya katalog-dışı serbest metin
  quantity           Decimal  @db.Decimal(12, 3)
  estimatedUnitPrice Decimal? @map("estimated_unit_price") @db.Decimal(12, 2)
  unit               String?

  request PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("purchase_request_items")
}

model PurchaseOrder {
  id                String  @id
  clinicId          String  @map("clinic_id")
  organizationId    String  @map("organization_id")
  supplierId        String  @map("supplier_id") // inventory Supplier (bounded-context)
  purchaseRequestId String? @map("purchase_request_id") // kaynak talep (opsiyonel)

  status       PurchaseOrderStatus @default(DRAFT)
  orderDate    DateTime            @map("order_date")
  expectedDate DateTime?           @map("expected_date")
  currency     Currency            @default(TRY)

  netTotal   Decimal @map("net_total") @db.Decimal(14, 2)
  vatTotal   Decimal @map("vat_total") @db.Decimal(14, 2)
  grandTotal Decimal @map("grand_total") @db.Decimal(14, 2)

  /// Bu siparişe eşleştirilmiş alış faturalarının KDV dahil toplamı. Kaynak-doğru
  /// veri `purchase_invoices.purchase_order_id`'dir; bu kolon o toplamın sayacıdır
  /// ve eşleştirme/eşleştirme-kaldırma ile AYNI transaction'da (sipariş satırı
  /// FOR UPDATE kilitliyken) güncellenir — bu yüzden sapmaz.
  invoicedTotal Decimal                    @default(0) @map("invoiced_total") @db.Decimal(14, 2)
  billingStatus PurchaseOrderBillingStatus @default(NOT_BILLED) @map("billing_status")

  note String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items    PurchaseOrderItem[]
  receipts PurchaseOrderReceipt[]

  @@index([clinicId, status])
  @@index([clinicId, billingStatus])
  @@index([organizationId])
  @@index([supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id      String @id
  orderId String @map("order_id")

  productId        String? @map("product_id") // katalog ürünü (teslimde stok girer)
  description      String
  quantityOrdered  Decimal @map("quantity_ordered") @db.Decimal(12, 3)
  quantityReceived Decimal @default(0) @map("quantity_received") @db.Decimal(12, 3)
  unitPrice        Decimal @map("unit_price") @db.Decimal(12, 2)
  vatRate          Int     @default(0) @map("vat_rate")
  lineNet          Decimal @map("line_net") @db.Decimal(14, 2)
  lineVat          Decimal @map("line_vat") @db.Decimal(14, 2)
  lineTotal        Decimal @map("line_total") @db.Decimal(14, 2)

  order        PurchaseOrder              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  receiptLines PurchaseOrderReceiptLine[]

  @@index([orderId])
  @@map("purchase_order_items")
}

/// Mal kabul **günlüğü** (başlık). `purchase_order_items.quantity_received` kümülatif bir
/// sayaçtır ve tarih taşımaz: "31 Aralık itibarıyla faturası gelmemiş mal" (GRNI) sorusunun
/// cevabı kabulün ZAMANINA bağlıdır ve sonradan geri üretilemez — sayaç bugünkü toplamı verir,
/// 31 Aralık'ı vermez. Bu yüzden her kabul kendi kaydını bırakır.
///
/// Kabul komutuyla AYNI transaction'da yazılır (sipariş aggregate'i üretir); sayaç ile günlük
/// toplamı her an eşittir (`pnpm finans:degismezler` kontrol eder). Satır silinmez/güncellenmez.
///
/// `received_at` kabulün SİSTEME GİRİLDİĞİ andır, fiziksel teslim günü değildir (stok hareketi de
/// aynı anla damgalanır — ikisi birlikte tutarlıdır). Fiziksel teslim tarihi girişi ayrı bir karar.
model PurchaseOrderReceipt {
  id             String                     @id
  orderId        String                     @map("order_id")
  clinicId       String                     @map("clinic_id")
  organizationId String                     @map("organization_id")
  receivedAt     DateTime                   @map("received_at")
  /// Personel kimliği (Firebase UID — UUID değil). Backfill'de null.
  receivedById   String?                    @map("received_by_id")
  source         PurchaseOrderReceiptSource @default(GOODS_RECEIPT)
  createdAt      DateTime                   @default(now()) @map("created_at")

  order PurchaseOrder              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lines PurchaseOrderReceiptLine[]

  @@index([clinicId, receivedAt])
  @@index([orderId])
  @@map("purchase_order_receipts")
}

/// Kabulün kalem satırı. `unit_price` kabul anındaki birim fiyatın **anlık görüntüsüdür**:
/// GRNI tutarı (miktar × fiyat) günlüğün kendisinden hesaplanır; sipariş kaleminin sonradan
/// değişmesi geçmiş bir yılın tahakkukunu oynatamaz.
model PurchaseOrderReceiptLine {
  id        String  @id
  receiptId String  @map("receipt_id")
  itemId    String  @map("item_id")
  quantity  Decimal @db.Decimal(12, 3)
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)

  receipt PurchaseOrderReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  // Cascade: sipariş silinirken kalem ve günlük satırı hangi sırayla silinirse silinsin FK takılmasın
  // (RESTRICT, kalem silinmeden önce satırların silinmesine bağımlı bir sıra gerektirirdi).
  item    PurchaseOrderItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([receiptId])
  @@index([itemId])
  @@map("purchase_order_receipt_lines")
}
