model User {
  id       String  @id
  roleId   String
  clinicId String? @map("clinic_id")

  displayName String @map("display_name")

  email         String  @unique
  emailVerified Boolean @default(false) @map("email_verified")

  status GlobalStatus @default(ACTIVE)

  picture     String?
  phoneNumber String? @map("phone_number")

  role          Role    @relation(fields: [roleId], references: [id])
  workingClinic Clinic? @relation("clinic_staff", fields: [clinicId], references: [id])

  managedClinics     Clinic[]       @relation("clinic_managers")
  ownedOrganizations Organization[] @relation("organization_owners")

  providerProfile Provider?

  /// Rolün üstüne, klinik yöneticisi tarafından kişiye özel verilen ek yetkiler.
  grantedCapabilities UserCapability[] @relation("user_capabilities")
  /// Bu kullanıcının BAŞKALARINA verdiği yetkiler (kim verdi izi).
  issuedCapabilities  UserCapability[] @relation("capability_granters")

  lastLogin          DateTime            @default(now()) @map("last_login")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  deletedAt          DateTime?           @map("deleted_at")
  financeLedgers     FinanceLedger[]
  stockMovements     StockMovement[]
  staffNotifications StaffNotification[]

  @@map("users")
}
