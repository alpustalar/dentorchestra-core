// FinancialEvent — çift taraflı muhasebenin değişmez kaynağı.
// Her ekonomik olay önce buraya yazılır (append-only); posting bunu okuyup fiş üretir.
// NOT: bu tablo asla UPDATE/DELETE edilmez — yalnızca yeni satır eklenir.

enum FinancialEventType {
  SALES_INVOICE_ISSUED
  SALES_INVOICE_CANCELLED
  PURCHASE_INVOICE_RECEIVED
  PAYMENT_RECEIVED
  /// Tahsil edilmiş paranın müşteriye GERİ verilmesi (kart iadesi/iptali, nakit iade).
  /// Kendi tarihi olan ayrı bir ekonomik olaydır — tahsilat fişinin storno'su DEĞİL:
  /// para o gün gerçekten alınmıştı ve iade başka bir (hatta kapanmış) döneme düşebilir.
  PAYMENT_REFUNDED
  PAYMENT_MADE
  INSTRUMENT_RECEIVED
  INSTRUMENT_GIVEN
  INSTRUMENT_CLEARED
  STOCK_IN
  STOCK_OUT
  EXPENSE_RECORDED
  PAYROLL_ACCRUED
  DEPRECIATION
  FX_REVALUATION
  MANUAL_JOURNAL
  OPENING_BALANCE
  PERIOD_CLOSING
  CASH_SESSION_CLOSED
  /// Sağlayıcı hesap kapaması: kartla tahsil edilen paranın (108 Diğer Hazır
  /// Değerler) komisyon kesilerek bankaya geçmesi. Olmadığı sürece 108 **hiç
  /// kapanmaz**: her kart tahsilatı orada kalır (bilanço şişik), para 102'ye hiç
  /// girmez ve sağlayıcı komisyonu gider yazılmaz (kâr fazla görünür).
  PROVIDER_SETTLEMENT_RECEIVED
  /// Sağlık turizmi rezervasyonunun tahsilatı — platform defterine yazılır.
  /// Klinik defterine YAZILMAZ: klinik bu işleme finansal olarak taraf değildir.
  PLATFORM_BOOKING_SETTLED
  /// Rezervasyon iptali sonrası iade — PLATFORM_BOOKING_SETTLED fişinin ters
  /// yönü, ama **storno'su değil**: paranın geri gittiği günün kendi olayıdır
  /// (tahsilat fişi yerinde kalır, bkz. PAYMENT_REFUNDED). Üstlenilen iptal
  /// cezası bu fişte zarar olarak tanınır.
  PLATFORM_BOOKING_REFUNDED
}

model FinancialEvent {
  id             String  @id
  clinicId       String  @map("clinic_id") // defter sahibi şube (source-of-truth)
  organizationId String  @map("organization_id") // denormalize — konsolide raporlama
  performedById  String? @map("performed_by_id")

  type       FinancialEventType
  occurredAt DateTime           @map("occurred_at") // ekonomik olayın tarihi (vergi tarihi)

  payload Json // olaya özgü veri; tutarlar string olarak tutulur (Decimal hassasiyeti)

  sourceModule String  @map("source_module") // 'payment' | 'invoice' | 'pos' | ...
  sourceRefId  String? @map("source_ref_id") // ilgili Payment/Invoice id
  dedupeKey    String? @unique @map("dedupe_key") // idempotent append anahtarı

  createdAt DateTime @default(now()) @map("created_at")

  clinic       Clinic        @relation(fields: [clinicId], references: [id])
  journalEntry JournalEntry?

  @@index([clinicId, occurredAt])
  @@index([organizationId, occurredAt])
  @@index([sourceModule, sourceRefId])
  @@map("financial_events")
}
