enum PayoutTrigger {
  ON_PAYMENT
  ON_TREATMENT_COMPLETED
}

/// Kliniğin hukuki/vergisel işletme biçimi. Kullanıcı seçer (türetilemez); yıl sonu devrinin hedefini
/// belirler: COMPANY → 590/591 → 570/580, SOLE_PROPRIETOR → 590/591 → 500. Boş = henüz seçilmemiş
/// (kapanışta devir adımı atlanır, önizleme uyarır).
enum BusinessType {
  COMPANY
  SOLE_PROPRIETOR
}

enum RoundingDirection {
  NONE
  UP
  DOWN
  NEAREST
}

model Clinic {
  id             String @id
  organizationId String @map("organization_id")
  sectorId       String @map("sector_id")

  name String
  slug String @unique

  sector Sector @relation(fields: [sectorId], references: [id])

  phone     String?
  email     String?
  address   String? @db.Text
  city      String?
  district  String?
  latitude  Float?
  longitude Float?

  // TODO: appointment settings'e alınabilir
  consultationSlotDuration Int @default(15)

  status   GlobalStatus @default(ACTIVE)
  timezone TimeZone     @default(Europe_Istanbul)

  /// Platformun kendi defter sahibi "şube"si — gerçek bir klinik değildir.
  /// Sağlık turizmi komisyonu buraya postlanır (bkz. Organization.isPlatform).
  /// Kiracıya dönük klinik listelerinden dışlanır.
  isPlatform Boolean @default(false) @map("is_platform")

  logo String?

  organization Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  managers             User[]                      @relation("clinic_managers")
  staffs               User[]                      @relation("clinic_staff")
  treatments           Treatment[]
  treatmentPackages    TreatmentPackage[]
  providers            Provider[]
  appointments         Appointment[]
  patients             Patient[]
  medicalFiles         MedicalFile[]
  resources            Resource[]
  patientGroups        PatientGroup[]
  portalSettings       ClinicPortalSettings?
  paymentGateway       ClinicPaymentGateway?
  iyzicoTerminalConfig ClinicIyzicoTerminalConfig?
  eDocumentIntegrationConfig EDocumentIntegrationConfig?
  governmentSpecs      ClinicGovernmentSpecs?
  // NOT: WhatsApp/Telegram/Instagram kanal ve AI asistan config'leri messaging
  // bounded-context'ine ait olup MongoDB'de tutulur (bkz. documents/messaging-microservice.md).
  // İlişki yerine messaging tarafında düz `clinicId` string'i taşınır; klinik silindiğinde
  // temizlik DB cascade'i ile değil event ile yürür.
  healthTourismConfig  ClinicHealthTourismConfig?
  products             Product[]
  subscriptions        Subscription[]

  clinicAvailabilities ClinicAvailability[]
  clinicExceptions     ClinicException[]
  productBatches       ProductBatch[]
  stockMovements       StockMovement[]
  productUsages        ProductUsage[]
  posDevices           PosDevice[]
  metaAdAccounts       MetaAdAccount[]
  leads                Lead[]

  // Finansal defter
  accounts              Account[]
  accountingPeriods     AccountingPeriod[]
  parties               Party[]
  financialEvents       FinancialEvent[]
  journalEntries        JournalEntry[]
  taxParameters         TaxParameter[]
  appointmentSettings   ClinicAppointmentSettings?
  clinicFinanceSettings ClinicFinanceSettings?

  @@map("clinics")
}

model ClinicAvailability {
  id       String @id
  clinicId String @map("clinic_id")

  dayOfWeek   Int @map("day_of_week") // 0-6
  startMinute Int @map("start_minute") // Örn: 540 (09:00)
  endMinute   Int @map("end_minute") // Örn: 1080 (18:00)

  isClosed Boolean @default(false) @map("is_closed")

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, dayOfWeek])
  @@map("clinic_availabilities")
}

model ClinicPortalSettings {
  id       String @id
  clinicId String @unique @map("clinic_id")

  apiKey String @unique @map("api_key")

  customDomain String? @unique @map("custom_domain") // Örn: portal.dentistalp.com (Premium SaaS özelliği)

  primaryColor String  @default("#00bcd4") @map("primary_color")
  customTitle  String? @map("custom_title") // Örn: "Acıbadem Diş Özel Hasta Paneli"

  showOnlineBooking  Boolean @default(true) @map("allow_online_booking") // Portalda hastalar için randevu alma kısmı gözüksün mü
  showMedicalRecords Boolean @default(true) @map("show_medical_records") // Reçete, tanı ve anamnez formları hastaya açık olsun mu?
  showFinancials     Boolean @default(false) @map("show_financials") // Hasta kendi kalan borç/alacak tablosunu görsün mü?
  showRaysAndImages  Boolean @default(true) @map("show_rays_and_images") // Röntgen ve klinik içi fotoğraflar portala düşsün mu?

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("clinic_portal_settings")
}

model ClinicAppointmentSettings {
  id       String @id
  clinicId String @unique @map("clinic_id")

  // Hastanın randevu alma / iptal / erteleme kuralları
  allowPatientBooking  Boolean @default(true) @map("allow_patient_booking") // Hasta panelden kendi randevusunu oluşturabilsin mi?
  rescheduleLimitHours Int     @default(6) @map("reschedule_limit_hours") // Kaç saat kalana kadar erteleyebilir
  cancelLimitHours     Int     @default(24) @map("cancel_limit_hours") // Kaç saat kalana kadar iptal edebilir
  allowPatientCancel   Boolean @default(true) @map("allow_patient_cancel") // Hasta panelden kendi iptal edebilsin mi?

  staffAllowOverbooking Boolean @default(true) @map("allow_overbooking") // Çalışanlar hekime veya koltuğa aynı anda çift randevu yazılabilsin mi?

  sendSmsReminderHours Int @default(24) @map("send_sms_reminder_hours") // Randevuya kaç saat kala hatırlatma gitsin

  maxActivePatientBookings Int @default(3) @map("max_active_patient_bookings") // Bir hastanın aynı anda gelecekte sahip olabileceği max randevu sayısı

  requireReminderResponse Boolean @default(false) @map("require_reminder_response") // Hastadan WhatsApp üzerinden "GELECEĞİM/GELEMEYECEĞİM" onayı zorunlu kılınsın mı?

  // Çift rezervasyon / Onay kuralları
  requireConfirmation  Boolean @default(false) @map("require_confirmation") // Randevu alındığında sekreter onayı gereksin mi?
  maxFutureBookingDays Int     @default(90) @map("max_future_booking_days") // En fazla kaç gün sonrasına randevu açılabilir?

  // Slot üretimi: açık randevu slotları bu adımla (dakika) hesaplanır
  slotDurationMinutes Int @default(30) @map("slot_duration_minutes") // Varsayılan randevu slot uzunluğu (dakika)

  // İlişki (One-to-One)
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("clinic_appointment_settings")
}

model ClinicFinanceSettings {
  id       String @id
  clinicId String @unique @map("clinic_id")

  defaultCurrency Currency @default(TRY) @map("default_currency")

  roundingType RoundingDirection @default(NONE) @map("rounding_type") // küsürat yuvarlama yönü

  invoicePrefix String @default("KLN") @map("invoice_prefix") // Fatura ön eki (Örn: AAA)

  // TODO: subscription module e göre burda değişim yapılacak. e-fatura modülü satın alındığında

  autoCreateInvoice Boolean @default(true) @map("auto_invoice_on_payment") // Ödeme alındığında fatura otomatik oluşsun mu?

  autoSendDebtReminder Boolean @default(false) @map("auto_send_debt_reminder") // Borç hatırlatma mesajları otomatik gitsin mi?

  // --- Vergi/Maliyet Kuraları ---
  defaultVatRate  Decimal @default(20) @map("default_vat_rate") @db.Decimal(5, 2) // Varsayılan KDV oranı
  useCostTracking Boolean @default(true) @map("use_cost_tracking") // Stok maliyeti randevuya işlensin mi?

  // --- Borç/Alacak Kuraları ---
  allowNegativeBalance     Boolean @default(false) @map("allow_negative_balance") // Hasta borçlu kalabilir mi?
  maxNegativeBalanceAmount Decimal @default(0) @map("max_negative_balance_amount") @db.Decimal(12, 2) // Maksimum borçlanma limiti
  maxInstallmentCount      Int     @default(12) @map("max_installment_count") // Maksimum taksit sayısı (Klinik sınırı)

  // --- İndirim Kuralı ---
  // İşlem satırında verilebilecek maksimum indirim yüzdesi. Aşan indirimi yalnız
  // kliniği yöneten aktör (klinik sahibi / şube müdürü) onaylayabilir; personel
  // için mutlak sınırdır. 0 = indirim verilemez (varsayılan: kapalı).
  maxDiscountPercent Decimal @default(0) @map("max_discount_percent") @db.Decimal(5, 2)

  // --- Entegrasyon/Raporlama ---

  isEInvoiceActive Boolean @default(false) @map("is_e_invoice_active") // E-Fatura/E-Arşiv entegrasyonu aktif mi?

  fiscalYearStartMonth Int @default(1) @map("fiscal_year_start_month") // Mali yıl başlangıcı (Genelde 1)

  // İşletme biçimi (şirket / şahıs). Kayıt akışında zorunlu; null yalnız bu alandan ÖNCE açılmış klinikler içindir.
  businessType BusinessType? @map("business_type")

  // Doktor hak ediş "ON_PAYMENT" (Ödeme Alındıkça) veya "ON_TREATMENT_COMPLETED" (Tedavi Bittikçe)
  providerPayoutTrigger PayoutTrigger @default(ON_PAYMENT) @map("provider_payout_trigger")

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("clinic_finance_settings")
}

model ClinicException {
  id       String @id
  clinicId String @map("clinic_id")

  date     DateTime
  isClosed Boolean  @default(true) @map("is_closed")
  reason   String?

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@unique([clinicId, date])
  @@map("clinic_exceptions")
}
