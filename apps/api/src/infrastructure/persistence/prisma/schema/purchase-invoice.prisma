// Tedarikçiden alınan alış faturası (finance önmuhasebe). Satış faturasının
// (invoice.prisma) kardeşi; dış belge sağlayıcı yok — faturayı biz alır kaydederiz.
// clinicId/organizationId denormalize scalar (Invoice deseni — Clinic navigation yok).
// Kayıt sonrası PURCHASE_INVOICE_RECEIVED olayı yazılır → posting 150/770 + 191 / 320.

enum PurchaseInvoiceStatus {
  DRAFT // Taslak: Fatura bilgileri giriliyor, henüz resmiyet kazanmadı, muhasebeleşmedi (posting tetiklenmez).
  RECORDED // Kaydedildi/Onaylandı: Fatura sisteme işlendi. Bahsettiğin "PURCHASE_INVOICE_RECEIVED" olayı tetiklenir ve borç/gider posting işlemleri (150/770 vs) gerçekleşir.
  PAID // Ödendi: Faturanın bakiyesi tamamen kapatıldı (Kasa/Banka entegrasyonu tamamlandı).
  PARTIALLY_PAID // Kısmen Ödendi: Faturanın grandTotal değerinin bir kısmı ödendi, kalan borç var.
  CANCELLED // İptal Edildi: Fatura hatalı girildi ve ters kayıtla (storno) hükümsüz kılındı.
}

model PurchaseInvoice {
  id             String @id
  clinicId       String @map("clinic_id") // defter sahibi şube (source-of-truth)
  organizationId String @map("organization_id") // denormalize — konsolide raporlama
  supplierId     String @map("supplier_id") // tedarikçi (bounded-context: navigation yok)

  invoiceNumber String?  @map("invoice_number") // tedarikçinin belge no'su
  invoiceDate   DateTime @map("invoice_date")

  /// Eşleştirildiği satın alma siparişi (`supply/purchasing`). Bounded-context:
  /// scalar id, navigation YOK. Null = serbest fatura (siparişe bağlı değil).
  purchaseOrderId String? @map("purchase_order_id")

  // Karşı borç/gider hesabı: 150 (stok) | 770/760/740 (gider). Çağıran belirler.
  lineAccountCode String                @map("line_account_code")
  vatRate         Int                   @map("vat_rate")
  netTotal        Decimal               @map("net_total") @db.Decimal(12, 2) // matrah
  vatTotal        Decimal               @map("vat_total") @db.Decimal(12, 2) // indirilecek KDV
  grandTotal      Decimal               @map("grand_total") @db.Decimal(12, 2) // KDV dahil toplam
  currency        Currency              @default(TRY)
  status          PurchaseInvoiceStatus @default(RECORDED)

  /// İptal damgası (CLAUDE.md finans kuralı 7). `status = CANCELLED` kimin, ne zaman
  /// ve neden iptal ettiğini taşımıyordu; iptal storno fişi ürettiği için iz kalıcı
  /// olmak zorunda. `cancelledById` personel kimliğidir (Firebase UID — UUID değil).
  cancelledAt   DateTime? @map("cancelled_at")
  cancelledById String?   @map("cancelled_by_id")
  cancelReason  String?   @map("cancel_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Doğal anahtar: aynı tedarikçinin aynı belge numarası bir klinikte bir kez
  /// kayıtlanabilir. Mükerrer alış faturası gideri (770/150), 320 borcunu ve KDV
  /// indirimini (191) iki kez yazardı; uygulama kontrolü yarışı kapatmaz, bu kısıt
  /// kapatır. `invoice_number` null olan satırlar (belge no'su girilmemiş fatura)
  /// Postgres'te NULL'lar birbirinden farklı sayıldığı için kısıt dışında kalır.
  @@unique([clinicId, supplierId, invoiceNumber])
  @@index([clinicId])
  @@index([organizationId])
  @@index([supplierId])
  @@index([purchaseOrderId])
  @@map("purchase_invoices")
}
