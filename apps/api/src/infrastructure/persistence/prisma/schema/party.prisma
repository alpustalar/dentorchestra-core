// Cari (Party) — çift taraflı defterin alt-defter kimliği.
// Finans'a aittir; yalnızca muhasebe-ilgili veri tutar (kimlik snapshot'ı, vergi,
// 120/320 hesap bağı). Kaynak kayda (Patient/Supplier/User) (originType, originId)
// ile bağlanır; finans bu tablolara DB-join yapmaz.

enum PartyType {
  INDIVIDUAL
  COMPANY
}

enum PartyRole {
  CUSTOMER
  PATIENT
  SUPPLIER
  EMPLOYEE
}

enum PartyOriginType {
  PATIENT
  SUPPLIER
  USER
  EXTERNAL
}

model Party {
  id             String  @id
  clinicId       String  @map("clinic_id")
  organizationId String  @map("organization_id") // denormalize — konsolide raporlama
  originId       String? @map("origin_id")

  type  PartyType
  roles PartyRole[]

  name       String
  taxNumber  String? @map("tax_number") // VKN (kurum)
  nationalId String? @map("national_id") // TCKN (gerçek kişi)
  taxOffice  String? @map("tax_office")

  email   String?
  phone   String?
  address String? @db.Text

  // e-belge
  isEInvoiceUser  Boolean @default(false) @map("is_einvoice_user")
  eInvoiceMailbox String? @map("einvoice_mailbox")

  // muhasebe bağı — Account.id (genelde 120 / 320).
  //
  // ⚠️ BUGÜN OKUNMUYOR VE YAZILMIYOR: fişleme hesabı **rol bazında** çözüyor
  // (bkz. account-resolver). Yani bu iki kolon "bu cari için özel hesap"
  // sözü veriyor ama hiçbir yol onu dikkate almıyor. Cari-özel hesap ihtiyacı
  // doğduğunda ya çözümleme noktasında (account-resolver) zorlanır ya da
  // kolonlar kaldırılır — okunmayan kolon güvence değil süstür
  // (CLAUDE.md finans kuralı 10).
  receivableAccountId String? @map("receivable_account_id")
  payableAccountId    String? @map("payable_account_id")

  // kaynak kayıt eşlemesi (join yok)
  originType PartyOriginType @map("origin_type")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  clinic       Clinic        @relation(fields: [clinicId], references: [id])
  journalLines JournalLine[]

  @@unique([clinicId, originType, originId])
  @@index([clinicId])
  @@index([organizationId])
  @@map("parties")
}
