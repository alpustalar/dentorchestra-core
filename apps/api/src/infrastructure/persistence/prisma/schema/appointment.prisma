enum AppointmentSource {
  CLINIC_INTERNAL // Klinik içi (Sekreterya, Hekim Paneli)
  PATIENT_PORTAL // Hasta Portalı (White-Label Portalın içi)
  WEB_WIDGET // Kliniğin web sitesine gömdüğü randevu botu/widget'ı
  INTEGRATION // Harici entegrasyonlar (Örn: DoktorTakvimi, WhatsApp Bot)
}

enum AppointmentCreatorType {
  CLINIC_STAFF // Klinik personeli (Sekreter, Hekim, Yönetici)
  PATIENT // Hastanın bizzat kendisi (Portal veya Widget üzerinden)
  AI_AGENT // Yapay Zeka Ajanı (Sesli arama asistanı veya WhatsApp AI Ajanı)
  SYSTEM // Sistem içi otomatik süreçler (Örn: Yinelenen randevu tetikleyicisi)
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  ARRIVED // Hasta kliniğe geldi / check-in yapıldı (bekleme odasında)
  CANCELLED
  COMPLETED
  NOSHOW
}

enum ExaminationType {
  FIRST_VISIT // İlk muayene
  FOLLOW_UP // Kontrol muayenesi
  EMERGENCY // Acil
}

enum VisitType {
  SCHEDULED // Randevulu
  WALK_IN // Randevusuz
  REFERRAL // Sevkli
}

model Appointment {
  id String @id

  patientName  String  @map("patient_name")
  patientPhone String  @map("patient_phone")
  patientEmail String? @map("patient_email")

  startTime DateTime @map("start_time")
  endTime   DateTime @map("end_time")

  source AppointmentSource @default(CLINIC_INTERNAL) @map("source")

  timezone TimeZone @default(Europe_Istanbul)

  treatmentType String? @map("treatment_type")
  notes         String? @db.Text

  approvedAt DateTime? @map("approved_at") // Onaylandığı an
  approvedBy String?   @map("approved_by") // Onaylayan Personelin ID'si

  creatorType AppointmentCreatorType @default(CLINIC_STAFF) @map("creator_type")

  // Randevuyu oluşturanın kimliği (Polymorphic mantık)
  createdById       String? @map("created_by_id") // Staff ID, Patient ID veya AI Agent Config ID
  createdByRealName String? @map("created_by_real_name") // Raporlarda hızlı basmak için (Örn: "DentalAI v2", "Sekreter Ayça")

  status AppointmentStatus @default(PENDING)

  checkedInAt DateTime? @map("checked_in_at") // Hasta check-in (ARRIVED) zamanı — bekleme sırası için

  reminderSentAt DateTime? @map("reminder_sent_at") // Randevu hatırlatması gönderildiği an (tekrarı önlemek için)

  canceledAt   DateTime? @map("canceled_at")
  canceledBy   String?   @map("canceled_by")
  cancelReason String?   @map("cancel_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Optimistic concurrency control — her save() ile artar; guard'lı update eşzamanlı
  // lost-update'i yakalar (bkz. appointment.command.repository.save).
  version Int @default(0)

  examinationType ExaminationType? @map("examination_type")
  visitType       VisitType?       @map("visit_type")
  isConsultation  Boolean          @map("is_consultation")

  externalSystem ExternalSystem? @map("external_system")
  externalId     String?         @unique @map("external_id")

  treatmentId String? @map("treatment_id")
  clinicId    String  @map("clinic_id")
  providerId  String  @map("provider_id")
  patientId   String  @map("patient_id")
  resourceId  String? @map("resource_id")

  isDeleted Boolean   @default(false) @map("is-deleted")
  deletedAt DateTime? @map("deleted-at")

  treatment Treatment? @relation(fields: [treatmentId], references: [id])
  clinic    Clinic     @relation(fields: [clinicId], references: [id])
  provider  Provider   @relation(fields: [providerId], references: [id])
  patient   Patient    @relation(fields: [patientId], references: [id])
  resource  Resource?  @relation(fields: [resourceId], references: [id])

  medicalFile           MedicalFile[]
  payment               Payment?
  productUsages         ProductUsage[]
  diagnoses             AppointmentDiagnosis[]
  procedures            AppointmentProcedure[]
  eNabizSync            ENabizSync?
  /// Çoklu: iptal edilmiş faturalar yerinde kalır (storno defterden silmez), bu
  /// yüzden bir randevunun **en fazla bir etkin** faturası olur ama geçmişinde
  /// birden çok iptal edilmiş fatura bulunabilir. Tekillik kısmî unique index'te.
  invoices              Invoice[]
  posTransactions       PosTransaction[]
  charges               TreatmentCharge[]
  appointmentEmbeddings AppointmentEmbedding[]

  @@index([patientPhone])
  @@index([startTime])
  @@map("appointments")
}

model AppointmentEmbedding {
  id            String @id
  appointmentId String @map("appointment_id")
  clinicId      String @map("clinic_id")

  contentChunk String                      @map("content_chunk") @db.Text // Vektörleştirilen metin parçası (örn: randevu notu)
  embedding    Unsupported("vector(1536)") // pgvector kolonu

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([clinicId])
  @@index([appointmentId])
  @@map("appointment_embeddings")
}
